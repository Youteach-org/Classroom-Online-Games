{
  "classroomGames": {
    "supportMeter": {
      ".read": true,
      ".write": true,
      "sessions": {
        "$sessionId": {
          ".validate": "!newData.exists() || (newData.hasChildren(['setNumber','status','createdAt']) && newData.child('setNumber').isNumber() && newData.child('setNumber').val() >= 1 && newData.child('setNumber').val() <= 3 && (newData.child('status').val() === 'open' || newData.child('status').val() === 'closed'))"
        }
      },
      "sessionTokens": {
        "$token": {
          ".validate": "!newData.exists() || (newData.hasChild('sessionId') && newData.child('sessionId').isString())"
        }
      },
      "runs": {
        ".indexOn": [
          "sessionId",
          "lastSeen"
        ],
        "$runId": {
          ".validate": "!newData.exists() || (newData.hasChildren(['studentName','sessionId','setNumber','lastSeen']) && newData.child('studentName').isString() && newData.child('studentName').val().length <= 60 && newData.child('sessionId').isString() && newData.child('setNumber').isNumber() && newData.child('setNumber').val() >= 1 && newData.child('setNumber').val() <= 3 && newData.child('lastSeen').isNumber())"
        }
      }
    },
    "verbRunnerV2": {
      ".read": true,
      ".write": true,
      "sessions": {
        "$sessionCode": {
          ".validate": "!newData.exists() || (newData.hasChildren(['status','createdAt','settings']) && (newData.child('status').val() === 'active' || newData.child('status').val() === 'closed'))",
          "students": {
            "$runnerId": {
              ".validate": "!newData.exists() || (newData.hasChildren(['id','studentName','status','lastSeen']) && newData.child('id').isString() && newData.child('studentName').isString() && newData.child('studentName').val().length <= 60 && newData.child('status').isString())"
            }
          }
        }
      }
    },
    "talkTalk": {
      ".read": true,
      ".write": true,
      "sessions": {
        "$sessionId": {
          "teams": {
            "$teamKey": {
              "confirmations": {
                "$studentKey": {
                  ".validate": "!newData.exists() || (newData.hasChildren(['studentKey','teamKey','teamRevision','microphoneUsable','tier','storageAvailableBytes','confirmedAt']) && newData.child('studentKey').isString() && newData.child('teamKey').isString() && newData.child('teamRevision').isString() && newData.child('microphoneUsable').isBoolean() && newData.child('tier').isString() && newData.child('storageAvailableBytes').isNumber() && newData.child('confirmedAt').isNumber())"
                }
              },
              "hostStudentKey": {
                ".validate": "!newData.exists() || newData.isString()"
              },
              "status": {
                ".validate": "!newData.exists() || newData.isString()"
              },
              "captureMode": {
                ".validate": "!newData.exists() || newData.isString()"
              },
              "turnEvents": {
                "$eventId": {
                  ".validate": "!newData.exists() || newData.isObject()"
                }
              }
            }
          }
        }
      }
    }
  }
}
